generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////
// USER
/////////////////////
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  isActive Boolean @default(true)

  // Relations
  createdTasks    Task[]           @relation("CreatedTasks")
  taskAssignments TaskAssignee[]

  createdProjects Project[]
  memberships     ProjectMember[]

  comments     Comment[]
  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
}


/////////////////////
// PROJECT
/////////////////////
model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  members ProjectMember[]
  tasks   Task[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
}

/////////////////////
// PROJECT MEMBER (JOIN TABLE)
/////////////////////
model ProjectMember {
  id Int @id @default(autoincrement())

  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
}

/////////////////////
// TASK
/////////////////////
model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      Status    @default(TODO)
  priority    Priority
  dueDate     DateTime?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  createdById Int
  createdBy   User @relation("CreatedTasks", fields: [createdById], references: [id])

  assignees TaskAssignee[]
  comments  Comment[]
  logs      ActivityLog[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/////////////////////
// TASK ASSIGNEE (JOIN TABLE)
/////////////////////
model TaskAssignee {
  id     Int @id @default(autoincrement())

  taskId Int
  userId Int

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
}

/////////////////////
// COMMENT
/////////////////////
model Comment {
  id      Int    @id @default(autoincrement())
  content String

  taskId Int
  task   Task @relation(fields: [taskId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
}

/////////////////////
// ACTIVITY LOG
/////////////////////
model ActivityLog {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(fields: [taskId], references: [id])

  type     ActivityType
 oldValue String?
  newValue String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

/////////////////////
// ENUMS
/////////////////////
enum Role {
  ADMIN
  USER
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum Status {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  TASK_CREATED

  STATUS_CHANGE
  ASSIGNMENT_CHANGE
  DUE_DATE_CHANGE
  PRIORITY_CHANGE
  TITLE_CHANGE
  DESCRIPTION_CHANGE

  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
}


